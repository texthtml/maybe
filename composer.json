{
    "name": "texthtml/maybe",
    "description": "Option & Result types",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "TH\\Maybe\\": "src/"
        },
        "files": ["src/functions/internal.php", "src/functions/option.php", "src/functions/result.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "TH\\Maybe\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Mathieu Rochette",
            "email": "mathieu@texthtml.net"
        }
    ],
    "require": {
        "php": "^8.2",
        "texthtml/object-reaper": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0|^12.0|^13.0",
        "squizlabs/php_codesniffer": "^4.0",
        "slevomat/coding-standard": "^8.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "vimeo/psalm": "^6.0 || ^7.0",
        "texthtml/doctest": "^0.3",
        "carthage-software/mago": "^1.59",
        "infection/infection": "^0.29 || ^0.35"
    },
    "scripts": {
        "test": [
            "@php vendor/bin/phpunit",
            "@php vendor/bin/doctest",
            "@php vendor/bin/phpcs -ps",
            "@php vendor/bin/mago fmt --check",
            "@php vendor/bin/phpstan",
            "@php vendor/bin/psalm --no-progress",
            "@php vendor/bin/mago lint",
            "@php vendor/bin/mago analyze"
        ]
    },
    "config": {
        "platform": {
            "php": "8.2.27"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "infection/extension-installer": true
        }
    }
}
